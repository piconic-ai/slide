{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "worker-configuration.d.ts",
    "meta/",
    "docs/",
    "**/*.md",
    "**/*.mdx",
    ".pedit/"
  ]
}
