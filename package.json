{
  "name": "slide",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build && vite build -c vite.drop.config.ts && unocss && concurrently -k -n vite,uno,wrangler -c blue,magenta,green \"vite dev\" \"unocss --watch\" \"wrangler dev --live-reload --infer-origin-from-routes=false\"",
    "build": "vite build && vite build -c vite.drop.config.ts && unocss",
    "deploy": "vite build && vite build -c vite.drop.config.ts && unocss && wrangler deploy",
    "watch": "concurrently -k -n build,drop,uno -c blue,cyan,magenta \"vite build --watch\" \"vite build -c vite.drop.config.ts --watch\" \"unocss --watch\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@barefootjs/client": "^0.41.3",
    "@barefootjs/hono": "^0.41.3",
    "@barefootjs/jsx": "^0.41.3",
    "@barefootjs/router": "^0.41.3",
    "@barefootjs/shared": "^0.41.3",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "entities": "8.1.0",
    "hono": "^4.6.0",
    "jose": "^6.2.15",
    "markdown-it": "^15.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@barefootjs/cli": "^0.41.3",
    "@barefootjs/test": "^0.41.3",
    "@barefootjs/vite": "^0.41.3",
    "@cloudflare/puppeteer": "2.0.1",
    "@cloudflare/workers-types": "^4.20260702.1 || ^5.20260708.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "^9.0.0",
    "oxfmt": "0.76.0",
    "playwright": "1.64.1",
    "typescript": "^5.6.0",
    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
