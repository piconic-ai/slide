{
  "name": "slide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && unocss && concurrently -k -n vite,uno,wrangler -c blue,magenta,green \"vite dev\" \"unocss --watch\" \"wrangler dev --live-reload\"",
    "build": "vite build && unocss",
    "deploy": "vite build && unocss && wrangler deploy",
    "watch": "concurrently -k -n build,uno -c blue,magenta \"vite build --watch\" \"unocss --watch\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@barefootjs/client": "^0.40.2",
    "@barefootjs/hono": "^0.40.2",
    "@barefootjs/jsx": "^0.40.2",
    "@barefootjs/shared": "^0.40.2",
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "unocss": "^66.0.0",
    "@barefootjs/cli": "^0.40.2",
    "@cloudflare/workers-types": "^4.20260702.1 || ^5.20260708.1",
    "@barefootjs/test": "^0.40.2",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "@barefootjs/vite": "^0.40.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0",
    "@types/node": "^22.0.0",
    "vitest": "^4.0.0"
  }
}
