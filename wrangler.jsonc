{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slide",
  "account_id": "e680616185a3b617a32987a6571991b7",
  "main": "server.tsx",
  "compatibility_date": "2026-11-05",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "slide.piconic.ai", "custom_domain": true }],
  // Provisional cadence for expiring sessions and sweeping orphaned objects.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slide",
      "database_id": "8461532c-0fca-4eea-9513-d0ff800c0385",
    },
  ],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "slide-uploads" }],
  // Per-IP budgets per minute, applied by src/site/rate-limit.ts. Uploads send
  // one request per file, so their budget covers the largest deployment.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "MANAGEMENT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "OIDC_AUDIENCE": "https://slide.piconic.ai",
    "GITHUB_ACTOR_ID": "722500",
    // Client ID of the read-only GitHub App used for owner login. Login is
    // disabled until it and the GITHUB_APP_CLIENT_SECRET secret are set.
    "GITHUB_APP_CLIENT_ID": "Iv23licSaYttNGJsxOSU",
    // Origin registered as the GitHub App callback; override it in .dev.vars.
    "PUBLIC_ORIGIN": "https://slide.piconic.ai",
    // Overrides for src/uploads/limits.ts defaults. Limits and expiry apply to new
    // sessions; the receive lease applies to the next received file.
    "UPLOAD_LIMITS": {},
  },
}
