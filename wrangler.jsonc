{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slide",
  "account_id": "e680616185a3b617a32987a6571991b7",
  "main": "src/app/worker-routes.ts",
  // Only the stored bytes are cached, behind the gateway's authorization.
  // The default entrypoint runs on every request so each one is authorized.
  // Cache keys name immutable bytes and a revision, so cached entries may
  // outlive a Worker version; this applies only where caching is enabled.
  "cache": { "enabled": false, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "ContentFiles": { "type": "worker", "cache": { "enabled": true } },
    // Screenshots of public decks' first slides; see src/covers.
    "CoverShots": { "type": "worker", "cache": { "enabled": true } },
  },
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  // The Worker runs first so a deployment origin never answers with the
  // service's own files; src/app/routes.tsx serves them on the management host only.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "slide.community", "custom_domain": true },
    // The operator pages, behind Cloudflare Access; see src/operator.
    { "pattern": "admin.slide.community", "custom_domain": true },
    // Each deployment's own origin, d-<id>.slideusercontent.com. The domain
    // holds nothing but author files; see CONTENT_ORIGIN.
    {
      "pattern": "*.slideusercontent.com/*",
      "zone_name": "slideusercontent.com",
    },
  ],
  // Provisional cadence for expiring sessions and sweeping orphaned objects.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slide",
      "database_id": "8461532c-0fca-4eea-9513-d0ff800c0385",
    },
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "slide-uploads" },
    // The daily copy of the stored slide files, kept for 30 days after the
    // original is gone (docs/dev/backup.md). The bucket must exist before this
    // is deployed, and it is private with no lifecycle rule.
    { "binding": "UPLOADS_BACKUP", "bucket_name": "slide-uploads-backup" },
  ],
  // Counts of what is used, written by src/metrics (docs/dev/metrics.md).
  // The dataset is made by its first write. Without this binding the service
  // runs as before and the operator's metrics page says it is not set up.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "slide_events" },
  ],
  // Takes the cover of a deck that names no image of its own, through
  // @cloudflare/puppeteer; `wrangler dev` starts a local Chrome for it.
  "browser": { "binding": "BROWSER" },
  // Per-IP budgets per minute, applied by src/site/rate-limit.ts. Uploads send
  // one request per file, so their budget covers the largest deployment.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 },
    },
    {
      "name": "MANAGEMENT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    // Readers of one talk often share a venue's address, and the author asked
    // that an event of over 10,000 readers behind one address is never
    // refused (2026-11-26; a stopgap until #495). One reader's view counts the
    // share URL and /api/session (2), the covers of citing and cited slides
    // and of the two sections of other talks (24), and, as Chromium loads
    // every image of an article at once, up to 201 images of the article's
    // own slides (pages past 200 show the cover) and one page of each of 40
    // other slides: 267. 10,000 readers make 2,670,000. See
    // docs/dev/service-basics.md.
    {
      "name": "VIEWER_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 5000000, "period": 60 },
    },
    // Each view loads every file of the deck from its deployment origin (up
    // to 500 files a version when UPLOAD_LIMITS raises it), and covers a deck
    // names are read from there too (24 on the viewer's cards, 41 in an
    // article): 565. 10,000 readers make 5,650,000.
    {
      "name": "CONTENT_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 6000000, "period": 60 },
    },
    // New images of a deck's pages, counted per deployment, not per IP; see
    // PAGE_SHOTS_PER_MINUTE in src/covers/shot.ts.
    {
      "name": "PAGE_SHOT_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "vars": {
    // Origin under which each deployment gets its own content origin. It must
    // be a different site from PUBLIC_ORIGIN; override it in .dev.vars.
    "CONTENT_ORIGIN": "https://slideusercontent.com",
    // Origin of the management pages and share URLs; override it in
    // .dev.vars.
    "PUBLIC_ORIGIN": "https://slide.community",
    // Origin of the operator pages. Only this host answers with them, and
    // only to requests carrying a Cloudflare Access token for the team in
    // ACCESS_TEAM_DOMAIN and the application in ACCESS_AUD. Until those two
    // are set, the host answers every request as missing.
    "OPERATOR_ORIGIN": "https://admin.slide.community",
    // The Cloudflare Access team and the audience tag of the application
    // that guards OPERATOR_ORIGIN; both are declared in the infra repository
    // and neither is a secret. Who may pass is the application's policy, not
    // anything here. Changing either hands that decision to another team or
    // application, so the author confirms such a change before it is merged.
    "ACCESS_TEAM_DOMAIN": "https://piconic-ai.cloudflareaccess.com",
    "ACCESS_AUD": "75d8648d91d36070a1a37d1c93374a597c2bf842c65f022d4ee004e2a39f3c91",
    // Overrides for src/uploads/limits.ts defaults. Limits and expiry apply to new
    // sessions; the receive lease applies to the next received file.
    "UPLOAD_LIMITS": {},
  },
}
